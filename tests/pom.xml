<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.vidyullatha</groupId>
  <artifactId>portfolio-ui-tests</artifactId>
  <version>1.0.0</version>
  <name>Portfolio UI Tests</name>
  <description>
    End-to-end UI automation for the portfolio site: Java, Playwright and TestNG,
    data-driven from the same _data/*.yml files that generate the page.
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <playwright.version>1.51.0</playwright.version>
    <testng.version>7.10.2</testng.version>
    <snakeyaml.version>2.3</snakeyaml.version>

    <!-- Defaults; override on the command line, e.g. -Dbrowser=firefox -->
    <browser>chromium</browser>
    <baseUrl>http://localhost:4000/</baseUrl>
    <headless>true</headless>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
    </dependency>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>${testng.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>${snakeyaml.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>testng.xml</suiteXmlFile>
          </suiteXmlFiles>
          <systemPropertyVariables>
            <browser>${browser}</browser>
            <baseUrl>${baseUrl}</baseUrl>
            <headless>${headless}</headless>
            <dataDir>${project.basedir}/../_data</dataDir>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Runs the Playwright CLI bundled in the jar, used to install browsers.
           See "Install browsers" in tests/README.md and the CI workflow. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
